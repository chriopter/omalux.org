---
interface Preset { id: string; name: string; group: string; description: string; image: string; width: number; height: number; modules: {name: string; enabled: boolean}[]; }
interface Props { catalog: { original: {image: string}; presets: Preset[] }; }
const { catalog } = Astro.props;
const groups = [...new Set(catalog.presets.map(p => p.group))];
---
<section class="gallery" aria-label="Preset catalogue">
  <div class="toolbar">
    <label class="search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><span class="sr-only">Search presets</span><input id="preset-search" type="search" placeholder="Search looks…" autocomplete="off" /></label>
    <button id="original-toggle" type="button" aria-pressed="false"><span aria-hidden="true">◐</span> Show original</button>
    <span id="preset-count" role="status" aria-live="polite">{catalog.presets.length} looks</span>
  </div>
  <div class="filters" aria-label="Filter presets by group"><button class="filter" data-group="all" aria-pressed="true">All looks <span>{catalog.presets.length}</span></button>{groups.map(group => <button class="filter" data-group={group} aria-pressed="false">{group}</button>)}</div>
  <div class="groups">
    {groups.map(group => <section class="preset-group" data-group={group} aria-label={group}>
      <div class="group-heading"><h2>{group}</h2><span>{catalog.presets.filter(p => p.group === group).length.toString().padStart(2, '0')}</span></div>
      <div class="grid">{catalog.presets.filter(p => p.group === group).map(p => <button class="preset-card" type="button" data-id={p.id} data-search={`${p.name} ${p.group} ${p.description}`.toLowerCase()} aria-label={`Explore ${p.name}`}>
        <div class="picture"><img src={p.image} data-preview={p.image} width={p.width} height={p.height} alt={`Beach photograph with ${p.name} preset`} loading="lazy" decoding="async" /><span class="explore" aria-hidden="true">Compare <span>↗</span></span></div>
        <div class="caption"><h3>{p.name}</h3><span aria-hidden="true">↗</span></div>
      </button>)}</div>
    </section>)}
  </div>
  <div id="no-presets" hidden><h2>No matching looks</h2><p>Try another name or group.</p><button id="clear-filters" type="button">Clear filters</button></div>
</section>
<dialog id="preset-dialog" aria-labelledby="detail-name">
  <div class="dialog-header"><span id="detail-group"></span><button id="close-detail" type="button" aria-label="Close preset details">✕</button></div>
  <div class="compare-frame">
    <img id="detail-after" alt="Preset preview" width="640" height="427" />
    <img id="detail-before" class="before" src={catalog.original.image} alt="Original photograph" width="640" height="427" />
    <div class="divider" aria-hidden="true"></div><span class="image-label original-label">Original</span><span class="image-label preset-label">Preset</span>
  </div>
  <label class="comparison-control" for="comparison">Preset <input id="comparison" type="range" min="0" max="100" value="50" aria-label="Reveal original photograph" /> Original</label>
  <div class="detail-copy"><h2 id="detail-name"></h2><p id="detail-description"></p><details><summary>Applied modules <span id="module-count"></span></summary><ul id="detail-modules"></ul></details></div>
</dialog>
<script id="preset-data" type="application/json" set:html={JSON.stringify(catalog).replace(/</g, '\\u003c')} />
<script src="../scripts/presets.ts"></script>
<style>
.gallery { border-top:1px solid var(--line); }
button,input { font:inherit; }
button { cursor:pointer; }
.toolbar { display:flex; align-items:center; gap:20px; padding:24px 0 18px; }
.search { display:flex; align-items:center; gap:12px; width: min(390px,100%); }
.search svg { width:18px; height:18px; fill:none; stroke:var(--muted); stroke-width:1.5; flex-shrink:0; }
.search input { width:100%; padding:12px 0; border:0; background:none; color:var(--fg); outline-offset:3px; font-size:.9rem; }
.search input::placeholder {color:var(--muted);}
#original-toggle { margin-left:auto; background:none; border:1px solid var(--line); color:var(--fg); padding:10px 14px; border-radius:7px; font-size:.8rem; white-space:nowrap; }
#original-toggle span {margin-right:6px;}
#original-toggle[aria-pressed="true"] {border-color:var(--accent);color:var(--accent);}
#preset-count {font-size:.75rem;color:var(--muted);white-space:nowrap;min-width:52px;text-align:right;}
.filters {display:flex;flex-wrap:wrap;gap:8px;padding-bottom:12px;}
.filter {border:1px solid transparent;border-radius:6px;padding:9px 13px;background:none;color:var(--muted);font-size:.78rem;}
.filter:hover {color:var(--fg);background:var(--surface);}
.filter[aria-pressed="true"] {color:var(--fg);background:var(--surface);border-color:var(--line);}
.filter span {opacity:.5;margin-left:7px;font-size:.7rem;}
.group-heading {display:flex;align-items:center;gap:12px;margin:32px 0 18px;}
.group-heading h2 {font-size:.74rem;text-transform:uppercase;letter-spacing:.13em;font-weight:600;}
.group-heading span {color:var(--muted);font-size:.7rem;font-variant-numeric:tabular-nums;}
.grid {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px 24px;}
.preset-card {background:none;border:0;color:var(--fg);text-align:left;min-width:0;border-radius:9px;}
.picture {position:relative;aspect-ratio:3/2;overflow:hidden;border-radius:8px;background:var(--surface);border:1px solid var(--line);}
.picture img {display:block;width:100%;height:100%;object-fit:contain;}
.explore {position:absolute;bottom:12px;right:12px;display:flex;gap:18px;background:#111722df;color:#fff;padding:8px 11px;border-radius:5px;font-size:.7rem;opacity:0;transition:opacity .15s;}
.preset-card:hover .explore,.preset-card:focus-visible .explore {opacity:1;}
.caption {display:flex;justify-content:space-between;align-items:center;padding:15px 1px 2px;}
.caption h3 {font-size:.94rem;font-weight:500;letter-spacing:-.015em;}
.caption>span {font-size:1.1rem;color:var(--muted);}
.preset-card:hover .caption {color:var(--accent);}
#no-presets {padding:64px 16px;text-align:center;}
#no-presets h2 {font-size:1.3rem;font-weight:500;}
#no-presets p {color:var(--muted);margin:12px 0 20px;}
#clear-filters {background:none;border:1px solid var(--line);color:var(--fg);border-radius:6px;padding:10px 16px;}
dialog {width:min(850px,calc(100vw - 32px));max-height:calc(100dvh - 32px);margin:auto;border:1px solid var(--line);border-radius:14px;background:var(--surface);color:var(--fg);padding:0;box-shadow:0 32px 120px #0008;}
dialog::backdrop {background:#03060ccc;backdrop-filter:blur(8px);}
.dialog-header {display:flex;align-items:center;justify-content:space-between;padding:12px 20px;}
#detail-group {color:var(--muted);font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;}
#close-detail {border:0;background:none;color:var(--fg);padding:8px;font-size:1rem;border-radius:4px;}
.compare-frame {position:relative;aspect-ratio:3/2;background:#0b0d12;--reveal:50%;}
.compare-frame img {display:block;width:100%;height:100%;object-fit:contain;}
.compare-frame .before {position:absolute;inset:0;clip-path:inset(0 calc(100% - var(--reveal)) 0 0);}
.divider {position:absolute;top:0;bottom:0;left:var(--reveal);width:1px;background:#fff9;}
.image-label {position:absolute;bottom:14px;border-radius:4px;background:#111722bb;color:white;font-size:.65rem;padding:5px 8px;}
.original-label {left:14px;}.preset-label {right:14px;}
.comparison-control {display:flex;align-items:center;gap:16px;padding:18px 24px;color:var(--muted);font-size:.72rem;}
.comparison-control input {width:100%;accent-color:var(--accent);cursor:ew-resize;}
.detail-copy {padding:6px 24px 28px;}
.detail-copy h2 {font-size:1.8rem;letter-spacing:-.04em;font-weight:550;}
.detail-copy p {margin-top:12px;line-height:1.65;color:var(--muted);font-size:.88rem;}
.detail-copy details {border-top:1px solid var(--line);margin-top:22px;padding-top:18px;}
.detail-copy summary {cursor:pointer;font-size:.8rem;}
#module-count {color:var(--muted);margin-left:7px;}
#detail-modules {display:flex;gap:8px;flex-wrap:wrap;list-style:none;margin-top:14px;}
#detail-modules :global(li) {background:var(--bg);padding:6px 9px;border:1px solid var(--line);border-radius:5px;font-size:.72rem;color:var(--muted);}
.sr-only {position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);border:0;}
@media(max-width:850px) {.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 18px;}}
@media(max-width:550px) {.grid{grid-template-columns:1fr;gap:24px;} .toolbar{flex-wrap:wrap;gap:10px;} .search{width:100%;} #original-toggle{margin-left:0;} #preset-count{margin-left:auto;} .filters{gap:4px;} .filter{padding:8px 10px;} .group-heading{margin-top:26px;} }
@media(prefers-reduced-motion:reduce) {.explore{transition:none;}}
</style>
