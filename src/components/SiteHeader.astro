<header>
				<a class="logo" href="/" aria-label="Omalux home"><img src="/assets/omalux-logo.svg" width="138" height="32" alt="Omalux" /></a>
				<nav aria-label="Main navigation">
<a class="presets-link" href="/presets" aria-current={Astro.url.pathname.startsWith("/presets") ? "page" : undefined}>Presets</a>
					<a class="github-link" href="https://github.com/chriopter/omalux" aria-label="Omalux on GitHub">
						<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.5 7.5 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
						<span>GitHub</span>
					</a>
					<button class="theme-switch" type="button" aria-label="Switch to light mode" title="Switch to light mode" hidden>
						<svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
						<svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 13.2A8.7 8.7 0 0 1 10.8 3.5a8.7 8.7 0 1 0 9.7 9.7Z"/></svg>
					</button>
				</nav>
			</header>
<style>
header {
				display: flex; align-items: center; justify-content: space-between;
				padding: 0.65rem 1.5rem;
			}
			.logo {
				display: inline-flex; align-items: center; min-height: 40px;
			}
			.logo img { display: block; width: 138px; height: 32px; filter: invert(1); }
			:global(:root[data-theme="light"]) .logo img { filter: none; }
			nav { display: flex; align-items: center; gap: 1.2rem; }
			.theme-switch { display: grid; place-items: center; width: 40px; height: 40px; padding: 9px; border: 1px solid var(--line); border-radius: 50%; background: var(--bg); color: var(--fg); cursor: pointer; }
			.theme-switch[hidden] { display: none; }
			.theme-switch:hover { border-color: var(--accent); color: var(--accent); }
			.theme-switch .moon { display: none; }
			:global(:root[data-theme="light"]) .theme-switch .sun { display: none; }
			:global(:root[data-theme="light"]) .theme-switch .moon { display: block; }
			:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
			@media (max-width: 480px) { header { padding: 1rem; } nav { gap: 0.65rem; } }

			nav a {
				color: var(--muted); text-decoration: none; font-size: 0.88rem;
				display: inline-flex; align-items: center; gap: 0.45rem;
				transition: color 0.2s ease;
			}
			nav a:hover { color: var(--fg); }
			nav svg { width: 18px; height: 18px; fill: currentColor; }
			nav .theme-switch svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }

nav .presets-link {
  min-height: 44px;
  padding: 0 20px;
  border-radius: 8px;
  background: var(--accent);
  color: var(--bg);
  font-size: 0.95rem;
  font-weight: 650;
  white-space: nowrap;
}
nav .presets-link:hover { color: var(--bg); filter: brightness(1.1); }
nav .presets-link[aria-current="page"] { outline: 2px solid var(--accent); outline-offset: 3px; }
@media (max-width: 480px) {
  nav .github-link span { display: none; }
  nav .github-link { justify-content: center; min-width: 32px; min-height: 44px; }
  nav .presets-link { padding: 0 14px; }
}
@media (max-width: 360px) {
  .logo img { width: 110px; height: auto; }
  nav { gap: 0.4rem; }
}
</style>
<script>
const control = document.querySelector<HTMLButtonElement>('.theme-switch')!;
const root = document.documentElement;
const system = matchMedia('(prefers-color-scheme: light)');
let explicit = false;
try { explicit = !!localStorage.getItem('omalux-theme'); } catch {}
function apply(theme: string) {
    root.dataset.theme = theme;
    const label = theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode';
    control.setAttribute('aria-label', label);
    control.title = label;
}
apply(root.dataset.theme || 'dark');
control.hidden = false;
control.addEventListener('click', () => {
    explicit = true;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    apply(next);
    try { localStorage.setItem('omalux-theme', next); } catch {}
});
system.addEventListener('change', () => { if (!explicit) apply(system.matches ? 'light' : 'dark'); });
</script>
