---
import SiteHead from '../components/SiteHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import cameras from '../data/cameras.json';

const automatic = cameras.filter(camera => camera.automatic);
const optional = cameras.filter(camera => !camera.automatic);
const pattern = (value: string) => value.replaceAll('%', '*');
---
<html lang="en">
  <head><SiteHead title="Cameras — Omalux" description="Camera presets for darktable: what each one turns on, for which camera, and how to install them." /></head>
  <body>
    <SiteHeader />
    <main>
      <section class="intro">
        <p class="eyebrow">BEFORE THE LOOK</p>
        <h1>What your camera<br /><span>needs first.</span></h1>
        <p class="lead">darktable knows every camera's colours. It does not always switch on what a camera writes into its files. These {cameras.length} presets do, per camera, before any style.</p>
        <p class="note"><span></span>darktable 5.6 · applies itself once imported</p>
      </section>

      <section class="table">
        <h2>Applied automatically</h2>
        <p class="section-lead">Imported once, these apply themselves the next time you open a file from that camera.</p>
        <ul>
          {automatic.map(camera => (
            <li>
              <div class="who"><strong>{camera.maker.replaceAll('%', '')}</strong><span>{pattern(camera.model) === '*' ? 'all models' : pattern(camera.model)}</span></div>
              <div class="what"><strong>{camera.module}</strong><span>{camera.description.split(': ').slice(1).join(': ') || camera.description}</span></div>
              <div class="files">{camera.files.map(file => <code>{file}</code>)}</div>
            </li>
          ))}
        </ul>
        {optional.length > 0 && (
          <div class="optional">
            <h2>To choose yourself</h2>
            <p class="section-lead">These change what darktable already does well, so they wait for you to pick them in the module.</p>
            <ul>
              {optional.map(camera => (
                <li>
                  <div class="who"><strong>{camera.maker.replaceAll('%', '')}</strong><span>{pattern(camera.model) === '*' ? 'all models' : pattern(camera.model)}</span></div>
                  <div class="what"><strong>{camera.module}</strong><span>{camera.description.split(': ').slice(1).join(': ') || camera.description}</span></div>
                  <div class="files">{camera.files.map(file => <code>{file}</code>)}</div>
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>

      <section class="install">
        <h2>Install</h2>
        <ol>
          <li>
            <h3>Get the files</h3>
            <p>Clone the repository, or download it as an archive. The camera presets are in <code>catalog/camera</code>.</p>
            <pre><code>git clone https://github.com/chriopter/omalux.git</code></pre>
          </li>
          <li>
            <h3>Copy any profiles</h3>
            <p>Where a preset selects an input profile, copy the <code>.icc</code> beside it into darktable's configuration under <code>color/in</code>, then restart darktable.</p>
          </li>
          <li>
            <h3>Import the presets</h3>
            <p>Preferences → <em>presets</em> → import, then select the <code>.dtpreset</code> files. Each one lists the camera it belongs to.</p>
          </li>
        </ol>
        <p class="hint">A camera preset never changes a look. It prepares the photograph, and the <a href="/styles">styles</a> build on that.</p>
      </section>

      <aside class="closing">
        <h2>Or use them in Omalux.</h2>
        <p>Omalux applies these presets for you and shows, for every photograph, what was loaded for that camera.</p>
        <a href="https://github.com/chriopter/omalux/releases/latest">Get Omalux <span aria-hidden="true">↗</span></a>
      </aside>
    </main>
    <SiteFooter />
  </body>
</html>
<style>
main { max-width: 1328px; margin: 0 auto; padding: 58px 32px 0; }
.intro { padding: 12px 0 56px; }
.eyebrow { color: var(--accent); font-size: .7rem; font-weight: 650; letter-spacing: .2em; margin-bottom: 22px; }
h1 { font-size: clamp(2.4rem, 5.7vw, 4.6rem); line-height: 1.07; letter-spacing: -.045em; font-weight: 620; }
h1 span { color: var(--muted); }
.lead { max-width: 570px; margin-top: 24px; color: var(--muted); font-size: 1.05rem; line-height: 1.7; }
.lead em { color: var(--fg); font-style: normal; }
.note { display: flex; align-items: center; gap: 9px; margin-top: 24px; color: var(--muted); font-size: .75rem; }
.note span { width: 6px; height: 6px; border-radius: 50%; background: #d0ad69; }

.layers-unused { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
.layers article { border: 1px solid var(--line); border-radius: 14px; padding: 28px 30px 26px; }
.layers h2 { font-size: 1.35rem; letter-spacing: -.03em; font-weight: 560; }
.layers .what { color: var(--accent); font-size: .82rem; margin: 8px 0 16px; }
.layers p { color: var(--muted); line-height: 1.7; font-size: .93rem; }
.layers .file { margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--line); font-size: .8rem; }
.layers .file code { color: var(--fg); }
.layers .file span { color: var(--muted); }

.install { margin-top: 72px; }
.install h2 { font-size: 1.6rem; letter-spacing: -.03em; font-weight: 550; margin-bottom: 28px; }
.install ol { list-style: none; counter-reset: step; display: grid; gap: 26px; }
.install li { counter-increment: step; padding-left: 52px; position: relative; }
.install li::before {
  content: counter(step); position: absolute; left: 0; top: -2px;
  width: 32px; height: 32px; display: grid; place-items: center;
  border: 1px solid var(--line); border-radius: 50%; color: var(--muted); font-size: .82rem;
}
.install h3 { font-size: 1rem; font-weight: 550; letter-spacing: -.01em; }
.install p { color: var(--muted); line-height: 1.7; font-size: .93rem; margin-top: 6px; max-width: 640px; }
.install em { color: var(--fg); font-style: normal; }
.install pre { margin-top: 12px; padding: 12px 16px; border: 1px solid var(--line); border-radius: 10px; overflow-x: auto; }
.install pre code { color: var(--fg); font-size: .82rem; }
.hint { margin-top: 30px; color: var(--muted); font-size: .85rem; }
code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .85em; }

.closing { margin-top: 72px; padding: 48px 0 64px; border-top: 1px solid var(--line); }
.closing h2 { font-size: 1.6rem; letter-spacing: -.03em; font-weight: 550; }
.closing p { color: var(--muted); line-height: 1.7; margin: 12px 0 24px; max-width: 620px; }
.closing a { color: var(--fg); text-underline-offset: 5px; }

@media (max-width: 860px) { .layers { grid-template-columns: 1fr; } }
@media (max-width: 600px) { main { padding: 32px 20px 0; } .intro { padding-bottom: 36px; } }

.section-lead { color: var(--muted); font-size: .93rem; line-height: 1.7; margin: -14px 0 22px; max-width: 640px; }
.table { margin-top: 8px; }
.table h2 { font-size: 1.6rem; letter-spacing: -.03em; font-weight: 550; margin-bottom: 20px; }
.table ul { list-style: none; border-top: 1px solid var(--line); }
.table li { display: grid; grid-template-columns: 1fr 1.5fr auto; gap: 24px; align-items: baseline;
            padding: 18px 2px; border-bottom: 1px solid var(--line); }
.table strong { font-weight: 550; font-size: .95rem; display: block; }
.table span { color: var(--muted); font-size: .85rem; display: block; margin-top: 3px; }
.table .what span { line-height: 1.6; }
.table .files { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
.table .files code { color: var(--muted); font-size: .75rem; border: 1px solid var(--line);
                     border-radius: 6px; padding: 3px 8px; white-space: nowrap; }
.optional { margin-top: 56px; }
.hint a { color: var(--fg); text-underline-offset: 4px; }
@media (max-width: 760px) { .table li { grid-template-columns: 1fr; gap: 10px; } .table .files { justify-content: flex-start; } }
</style>
